<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- MAIN APP THEME (AppCompat base, works fine with Jetpack Compose) -->
    <style name="Theme.PatientTracker" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Dark background for the whole app window -->
        <item name="android:windowBackground">@color/dark_main_bg</item>
        <item name="android:statusBarColor">@color/dark_main_bg</item>
        <item name="android:navigationBarColor">@color/dark_main_bg</item>
    </style>

    <!-- SPLASH SCREEN THEME: same family, different background if you want -->
    <style name="Theme.PatientTracker.Splash" parent="Theme.PatientTracker">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

</resources>